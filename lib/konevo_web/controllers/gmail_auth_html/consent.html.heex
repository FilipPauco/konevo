<main id="gmail-data-use-notice" class="min-h-screen bg-base-200 px-4 py-10 sm:px-6 sm:py-16">
  <div class="mx-auto w-full max-w-2xl">
    <a
      href={~p"/settings"}
      class="inline-flex items-center gap-2 text-sm font-medium text-base-content/60 transition-colors hover:text-primary"
    >
      <.icon name="icon-[tabler--arrow-left]" class="size-4" />
      {gettext("Back to Settings")}
    </a>

    <section class="mt-5 rounded-3xl border border-base-content/10 bg-base-100 p-6 shadow-xl shadow-base-content/8 sm:p-9">
      <div class="flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary">
        <.icon name="icon-[tabler--brand-gmail]" class="size-6" />
      </div>
      <p class="mt-6 text-sm font-semibold text-primary">{gettext("Before you connect")}</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight">
        {gettext("How Konevo will use your Gmail data")}
      </h1>
      <p class="mt-3 leading-7 text-base-content/65">
        {gettext(
          "This self-hosted Konevo instance will ask Google for access only after you acknowledge this notice and continue to Google's permission screen."
        )}
      </p>

      <div class="mt-7 space-y-3">
        <div class="rounded-2xl border border-base-content/10 p-4">
          <h2 class="font-semibold">{gettext("Email and mailbox state")}</h2>
          <p class="mt-1 text-sm leading-6 text-base-content/60">
            {gettext(
              "Read and sync email conversations, display them in Inbox, and update mailbox state such as read status when you do so in Konevo."
            )}
          </p>
        </div>
        <div class="rounded-2xl border border-base-content/10 p-4">
          <h2 class="font-semibold">{gettext("Sending and basic settings")}</h2>
          <p class="mt-1 text-sm leading-6 text-base-content/60">
            {gettext(
              "Send messages you request or approve through enabled automation, and import your Gmail signature when you choose to do so."
            )}
          </p>
        </div>
        <div class="rounded-2xl border border-base-content/10 p-4">
          <h2 class="font-semibold">{gettext("Calendar and account identity")}</h2>
          <p class="mt-1 text-sm leading-6 text-base-content/60">
            {gettext(
              "Read calendar events for the Konevo calendar and identify the Google email account being connected."
            )}
          </p>
        </div>
        <div class="rounded-2xl border border-primary/20 bg-primary/5 p-4">
          <h2 class="font-semibold text-primary">{gettext("Where the data goes")}</h2>
          <p class="mt-1 text-sm leading-6 text-base-content/70">
            {gettext(
              "Synced data stays in this self-hosted Konevo instance. If you use AI features or enable AI automation, only the content needed for that feature is sent to the AI provider configured for this instance."
            )}
          </p>
        </div>
      </div>

      <p class="mt-6 text-sm leading-6 text-base-content/55">
        {gettext(
          "Konevo does not sell Google user data or use it for advertising. You can disconnect Gmail in Settings at any time."
        )}
        <a
          href={~p"/privacy"}
          class="ml-1 font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary"
        >
          {gettext("Read the Privacy Policy")}
        </a>
        {gettext(" and")}
        <a
          href={~p"/terms"}
          class="ml-1 font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary"
        >
          {gettext("Terms of Use")}
        </a>.
      </p>

      <.form
        for={%{}}
        as={:gmail}
        action={~p"/integrations/gmail/consent"}
        method="post"
        id="gmail-consent-form"
        class="mt-7"
      >
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-base-content/10 p-4 transition-colors hover:bg-base-200/55">
          <input
            type="checkbox"
            name="gmail[acknowledged]"
            value="true"
            class="checkbox checkbox-primary mt-0.5"
            required
          />
          <span class="text-sm leading-6 text-base-content/70">
            {gettext(
              "I understand how this instance will access, store, and share Gmail data as described above."
            )}
          </span>
        </label>
        <div class="mt-6 flex flex-wrap justify-end gap-3">
          <a href={~p"/settings"} class="btn btn-ghost">{gettext("Cancel")}</a>
          <button id="continue-to-google" type="submit" class="btn btn-primary gap-2">
            {gettext("Continue to Google")}
            <.icon name="icon-[tabler--arrow-up-right]" class="size-4" />
          </button>
        </div>
      </.form>
    </section>
  </div>
</main>
