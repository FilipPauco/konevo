# Gmail OAuth (required in development and production)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# AI is configured in Settings → AI, not through environment variables.
# Add one OpenAI API key there; it is stored encrypted by the application.
# GPT-5.6 Luna handles high-volume work and GPT-5.6 Terra handles deeper work.

# Initial private owner account (used only by Konevo.Release.create_owner/0)
KONEVO_OWNER_EMAIL=owner@example.com
KONEVO_OWNER_PASSWORD=replace-with-a-strong-password

# Production database and endpoint
DATABASE_URL=ecto://postgres:postgres@localhost/konevo_prod
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
PHX_HOST=app.example.com

# Used only by deploy/hetzner/compose.yaml when running PostgreSQL on the
# same Hetzner server. Generate a long random value and do not reuse it.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Production email delivery through Resend
RESEND_API_KEY=re_your-resend-api-key
MAILER_FROM_EMAIL=no-reply@example.com
MAILER_FROM_NAME=Konevo

# Optional runtime tuning
PORT=4000
POOL_SIZE=10
UPLOADS_ROOT=priv/uploads
# ECTO_IPV6=true
# DNS_CLUSTER_QUERY=
